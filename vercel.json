{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "code-explainer/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/assets/(.*)", "dest": "code-explainer/dist/assets/$1" },
    { "src": "/(.*)", "dest": "code-explainer/dist/index.html" }
  ]
}